// Forge — Multi-LLM Vibe Coding Platform
// Prisma schema for the autonomous software factory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// LLM Providers (BYOK)
// ---------------------------------------------------------------------------

model LlmProvider {
  id          String   @id @default(cuid())
  userId      String                   // BYOK providers are per-user
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String                   // user-facing label e.g. "OpenAI Primary"
  provider    String                   // "zai" | "openai" | "anthropic" | "google" | "xai" | "local"
  model       String                   // e.g. "glm-4.6"
  apiKey      String                   // encrypted at rest (AES-256-GCM, v1: envelope)
  capabilities String                  // JSON array: ["coding","reasoning","long_context"]
  contextWindow Int      @default(128000)
  pricingPer1kInput  Float @default(0)
  pricingPer1kOutput Float @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agentAssignments AgentAssignment[]
  executions       AgentExecution[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id            String   @id @default(cuid())
  userId        String                   // owner
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String
  productSpec   String                 // user-provided product specification
  requirements  String                 // functional + non-functional constraints
  stack         String                 // desired tech stack (free text)
  status        String   @default("DRAFT")  // ProjectStatus enum
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])

  // GitHub connection (real GitHub repository — canonical source of code)
  githubRepo        String?            // owner/name
  githubConnected   Boolean  @default(false)
  githubDefaultBranch String  @default("main")

  // P15E: Canonical project HEAD — the verified HEAD of the project's
  // integration/default branch. Advances ONLY when a PR is merged.
  // NOT updated on task completion — task completion produces a candidate
  // commit + remote branch, but the canonical HEAD doesn't change until
  // that commit is merged into the integration branch.
  canonicalHeadSha  String?

  // Architecture
  architecture      Architecture?
  changeRequests    ArchitectureChangeRequest[]
  tasks             Task[]
  agents            AgentAssignment[]
  credentials       Credential[]
  events            BuildEvent[]
  // LEGACY metadata relations — NOT canonical repository state.
  // Real Git/GitHub is the canonical source (read via repository-reader.ts).
  files             RepoFile[]
  branches          RepoBranch[]
  commits           RepoCommit[]
  pullRequests      PullRequest[]
  readinessChecks   ReadinessCheck[]
  adrs              Adr[]
  buildJobs         BuildJob[]
  runtimeEvidence   RuntimeEvidence[]
}

// ---------------------------------------------------------------------------
// Architecture Contract
// ---------------------------------------------------------------------------

model Architecture {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version      String   @default("v1.0")
  hash         String                 // sha of canonical JSON
  frozen       Boolean  @default(false)
  frozenAt     DateTime?

  // Machine-readable contract (JSON string)
  contractJson String                 // full Architecture Contract
  // Human-readable markdown
  contractMd   String

  // Derived structures (denormalized for fast UI)
  components   String                 // JSON array of component descriptors
  dataModels   String                 // JSON array of data model descriptors
  apiContracts String                 // JSON array of API endpoint descriptors
  integrations String                 // JSON array of external integrations
  invariants   String                 // JSON array of invariants Guardian enforces
  constraints  String                 // JSON array of coding/infra constraints
  testingStrategy String             // JSON
  deploymentModel  String             // JSON

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ArchitectureChangeRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  problem     String
  affectedComponents String           // JSON array
  proposedChange String
  rationale   String
  risks       String
  migrationRequirements String
  affectedTests String               // JSON array
  affectedApis String                // JSON array
  affectedDependencies String        // JSON array
  estimatedImpact String
  status      String   @default("OPEN") // OPEN | APPROVED | REJECTED | IMPLEMENTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Adr {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  decision    String
  status      String   @default("accepted") // proposed | accepted | deprecated
  reason      String
  alternatives String
  consequences String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Task Graph
// ---------------------------------------------------------------------------

model Task {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code               String                 // e.g. "T-001"
  title              String
  description        String
  component          String                 // which architecture component
  agentType          String                 // AgentType enum
  dependencies       String   @default("[]") // JSON array of task codes
  inputs             String   @default("[]") // JSON array
  outputs            String   @default("[]") // JSON array
  acceptanceCriteria String   @default("[]") // JSON array
  requiredTests      String   @default("[]") // JSON array
  priority           Int      @default(5)    // 1 high → 10 low
  risk               String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status             String   @default("PLANNED") // TaskStatus enum
  attempts           Int      @default(0)
  maxAttempts        Int      @default(3)
  assignedModel      String?
  reviewStatus       String   @default("PENDING") // PENDING | PASSED | CHANGES_REQUESTED | FAILED
  architectureStatus String   @default("PENDING") // PENDING | PASS | WARNING | VIOLATION
  readinessStatus    String   @default("PENDING") // PENDING | PASSED | FAILED

  branchName         String?
  commitSha          String?
  filesChangedJson   String   @default("[]") // JSON array of file paths
  testResultsJson    String   @default("[]") // JSON array of test result objects
  guardianResultJson String?               // JSON Guardian verdict
  reviewResultJson   String?               // JSON Reviewer verdict
  implementationLog  String?               // raw agent output

  // P16: Integration lifecycle
  integrationState   String   @default("NONE") // NONE | INTEGRATION_PENDING | INTEGRATED | INTEGRATION_FAILED
  prNumber           Int?
  prUrl              String?
  prState            String?               // OPEN | MERGED | CLOSED

  failureReason      String?
  blockedReason      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  executions         AgentExecution[]
  evidence           TaskEvidence[]
}

// ---------------------------------------------------------------------------
// Agent Assignments (which model serves which role for this project)
// ---------------------------------------------------------------------------

model AgentAssignment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentType   String                  // AgentType enum
  providerId  String?
  provider    LlmProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  // last execution snapshot
  currentTaskId String?
  state        String   @default("IDLE") // IDLE | RUNNING | WAITING | ERROR
  lastActivity String?
  tokensUsed   Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executions   AgentExecution[]
}

// ---------------------------------------------------------------------------
// Agent Executions (evidence ledger)
// ---------------------------------------------------------------------------

model AgentExecution {
  id            String   @id @default(cuid())
  projectId     String
  taskId        String?
  agentType     String                  // AgentType enum
  providerId    String?
  provider      LlmProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model         String
  promptVersion String
  inputContext  String                 // JSON: what context was sent
  output        String                 // raw LLM output
  assignmentId  String?
  outputJson    String?                // parsed structured output if any
  filesChanged  String   @default("[]") // JSON array
  commitSha     String?
  testResults   String?                // JSON
  reviewResult  String?                // JSON
  guardianResult String?               // JSON
  architectureVersion String?
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  costUsd       Float    @default(0)
  durationMs    Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignment    AgentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Task Evidence Ledger (immutable, one record per attempt)
// Records REAL execution evidence: changed files, commands, test runs,
// guardian verdicts, review verdicts, integration checks. A task may have
// multiple evidence records (one per retry). The ledger is append-only —
// never UPDATE; only CREATE.
// ---------------------------------------------------------------------------

model TaskEvidence {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String

  architectureVersion String
  architectureHash    String
  commitSha           String?

  // P15B: Git evidence — derived from trusted execution state, not worker body
  executionId         String?                  // ExecutionJob that produced this evidence
  workerId            String?                  // Worker that executed
  branchName          String?                  // Expected branch (derived from task code + attempt)
  baseCommitSha       String?                  // Expected base (derived from task graph)
  pushedToRemote      Boolean  @default(false) // Worker pushed to remote
  remoteCommitVerified Boolean @default(false) // Control plane independently verified

  // Real execution evidence (JSON-encoded arrays/objects)
  changedFiles        String   @default("[]")  // JSON array of file paths
  commandsExecuted    String   @default("[]")  // JSON array of {command, exitCode, durationMs}
  testRuns            String   @default("[]")  // JSON array of TestResult objects
  runtimeChecks       String   @default("[]")  // JSON array of runtime check results
  guardianResults     String?                  // JSON: deterministic + LLM guardian results
  reviewResults       String?                  // JSON: review results
  integrationChecks   String   @default("[]")  // JSON array of integration check results

  // Summary counts for fast dashboard queries
  totalChecks         Int      @default(0)
  passedChecks        Int      @default(0)
  failedChecks        Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([executionId])
}

// ---------------------------------------------------------------------------
// Credentials / Secrets Manifest
// ---------------------------------------------------------------------------

model Credential {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String                 // e.g. STRIPE_SECRET_KEY
  purpose       String
  environment   String   @default("production") // production | test | sandbox | development
  provider      String?
  required      Boolean  @default(true)
  optional      Boolean  @default(false)
  validationMethod String?
  testSandboxSupport Boolean @default(false)
  whenRequired  String?
  // value is stored encrypted (AES-256-GCM, v1: envelope); never sent to LLMs as plaintext
  value         String?
  configured    Boolean  @default(false)
  validated     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Legacy repository metadata / cache.
//
// NOT canonical repository state. Never written by execution/integration paths.
// Canonical source is real Git/GitHub (read via src/lib/repository-reader.ts).
// These models may hold historical metadata but must NEVER be used as the
// source of truth for readiness decisions or repository display.
// ---------------------------------------------------------------------------

model RepoBranch {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  fromBranch  String?
  headSha     String?
  protected   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([projectId, name])
}

model RepoCommit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sha         String
  branchName  String
  parentSha   String?
  authorName  String   @default("forge-bot")
  authorEmail String   @default("forge@local")
  message     String
  filesChangedJson String @default("[]") // JSON array of {path, action}
  taskId      String?
  createdAt   DateTime @default(now())
}

model RepoFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  content     String
  language    String?
  bytes       Int      @default(0)
  // provenance
  createdInCommit String?
  taskId      String?
  // fake-impl detector flags
  suspiciousPatterns String @default("[]") // JSON array of patterns found
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, path])
}

model PullRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  branchName  String
  baseBranch  String   @default("main")
  state       String   @default("OPEN") // OPEN | MERGED | CLOSED
  body        String?
  taskId      String?
  commitsJson String   @default("[]")
  filesJson   String   @default("[]")
  mergedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, number])
}

// ---------------------------------------------------------------------------
// Verification — Production Readiness Gate
// ---------------------------------------------------------------------------

model ReadinessCheck {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String                  // BUILD | STATIC | TESTS | RUNTIME | INTEGRATIONS | DATA | AUTH | ERRORS | OBSERVABILITY | SECURITY | CONFIG | DEPLOYMENT
  name        String
  description String
  required    Boolean  @default(true)
  status      String   @default("PENDING") // PENDING | PASSED | FAILED | WARNING
  evidence    String?                 // JSON evidence object
  failureReason String?
  checkedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Build Events (audit log / live feed)
// ---------------------------------------------------------------------------

model BuildEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String                  // e.g. ARCHITECTURE_FROZEN, TASK_STARTED, COMMIT, GUARDIAN_PASS, REVIEW_FAILED
  level       String   @default("info") // info | warn | error | success
  message     String
  taskId      String?
  agentType   String?
  payload     String?                 // JSON
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Authentication & Multi-tenancy (NextAuth v4 + Prisma Adapter)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  USER
  DEMO_ADMIN
  DEMO_USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider
  passwordHash  String?
  // Authorization
  role          UserRole  @default(USER)
  isDemo        Boolean   @default(false)
  // Waitlist → account conversion
  waitlistEntry WaitlistEntry?
  // Owned resources
  projects      Project[]
  providers     LlmProvider[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Waitlist — sign-up requests awaiting admin approval
// ---------------------------------------------------------------------------

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  convertedUserId String? @unique // set when admin creates the account
  requestedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?  // admin userId

  user        User?    @relation(fields: [convertedUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 3: Durable Build Jobs — survive server restarts
// ---------------------------------------------------------------------------

model BuildJob {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // BUILD | EXECUTION | VERIFICATION
  status      String   @default("QUEUED") // QUEUED | CLAIMED | RUNNING | WAITING | SUCCEEDED | FAILED | CANCELLED | TIMED_OUT | BLOCKED
  taskId      String?
  attempt     Int      @default(0)

  // Durable lease fields (Phase 4)
  workerId    String?  // which worker claimed this job
  leaseId     String?  // unique lease identifier
  leaseExpiresAt DateTime?  // when the lease expires (for recovery)
  heartbeatAt DateTime?  // last worker heartbeat

  // Execution metadata
  executionId String?  // sandbox/worker job ID
  sandboxId   String?
  workDir     String?
  commitSha   String?
  branch      String?

  // Idempotency
  idempotencyKey String? @unique  // projectId+taskId+attempt

  // Results
  results     String?  // JSON: execution results
  errorMessage String?

  // Timing
  queuedAt    DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  timeoutMs   Int      @default(300000)

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([leaseExpiresAt])
}

// ---------------------------------------------------------------------------
// Phase 7: Worker Registry — real worker-owned scheduler
// ---------------------------------------------------------------------------

model WorkerRegistry {
  id                String   @id @default(cuid())
  workerId          String   @unique
  workerVersion     String
  protocolVersion   String
  capabilities      String   @default("[]") // JSON array: ["node","git","test","build"]
  maxConcurrency    Int      @default(1)
  currentConcurrency Int     @default(0)
  status            String   @default("STARTING") // STARTING | READY | BUSY | DRAINING | OFFLINE
  lastHeartbeat     DateTime @default(now())
  currentJobId      String?
  registeredAt      DateTime @default(now())

  // Phase 18G: Worker's Ed25519 public key for evidence signing.
  // Registered at worker registration. NEVER accepted from request body.
  // The control plane resolves this from the DB by workerId.
  publicKeyPem      String?

  @@index([status])
  @@index([lastHeartbeat])
}

// ---------------------------------------------------------------------------
// Phase 18Q: Worker Enrollment — pre-provisioned trusted worker identity.
//
// An admin creates a WorkerEnrollment BEFORE the worker starts.
// The enrollment binds a workerId to an expected public key fingerprint
// and a one-time enrollment secret.
//
// The worker proves possession of its Ed25519 private key by signing
// a challenge. The control plane verifies the signature against the
// expected public key fingerprint. Only then is the worker activated
// in WorkerRegistry.
//
// This removes the ability of anyone with FORGE_WORKER_SECRET to
// create arbitrary workerId → publicKey bindings.
//
// Lifecycle: PENDING → ACTIVE → (revoked by key rotation or admin)
// ---------------------------------------------------------------------------

model WorkerEnrollment {
  id                        String   @id @default(cuid())
  workerId                  String   @unique

  // Expected Ed25519 public key fingerprint (SHA-256 of the PEM, first 32 hex chars).
  // The worker must prove possession of the corresponding private key.
  expectedPublicKeyFingerprint String

  // One-time enrollment secret (bcrypt-hashed). Used by the worker to
  // identify which enrollment it's claiming. Single-use.
  enrollmentSecretHash      String

  // Status: PENDING (created, not yet activated) | ACTIVE (worker proved key) | REVOKED
  status                    String   @default("PENDING")

  // Single-use tracking
  activatedAt               DateTime?
  revokedAt                 DateTime?
  revokedReason             String?

  // Phase 18R: Enrollment expiration — a leaked enrollment secret should
  // not remain usable indefinitely.
  expiresAt                 DateTime

  // Admin who created the enrollment
  createdBy                 String?

  createdAt                 DateTime @default(now())

  @@index([status])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Phase 18U: Worker Re-registration Challenge — persisted, single-use.
//
// /api/worker/challenge creates a PENDING challenge record.
// /api/worker/register atomically consumes it (PENDING → CONSUMED).
// A challenge can authenticate exactly one re-registration, then is unusable.
// ---------------------------------------------------------------------------

model WorkerChallenge {
  id          String   @id @default(cuid())
  workerId    String
  nonce       String   @unique
  challenge   String   // Full: FORGE_REREGISTER:{workerId}:{nonce}:{expiryMs}
  expiresAt   DateTime
  status      String   @default("PENDING") // PENDING | CONSUMED | EXPIRED
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([workerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 7: ExecutionJob — individual task execution (separate from BuildJob)
// ---------------------------------------------------------------------------

model ExecutionJob {
  id              String   @id @default(cuid())
  projectId       String
  buildJobId      String?
  taskId          String?
  executionId     String   @unique  // stable id for idempotency
  attempt         Int      @default(0)

  status          String   @default("QUEUED") // QUEUED | CLAIMED | RUNNING | VERIFYING | SUCCEEDED | FAILED | TIMED_OUT | CANCELLED | BLOCKED

  // Lease
  workerId        String?
  leaseId         String?
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?

  // Required capabilities
  requiredCapabilities String @default("[]") // JSON array

  // Execution timeout (separate from lease timeout)
  executionTimeoutMs Int @default(1800000) // 30 minutes

  // Result
  commitSha       String?
  results         String?  // JSON
  errorMessage    String?

  // Timing
  queuedAt        DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  // Idempotency
  idempotencyKey  String   @unique  // projectId+taskId+attempt

  // Phase 18W-B: Substrate nonce issued by the control plane for this
  // execution. The worker passes it to the launcher; the launcher binds it
  // into the canonicalFactsJson that gets signed. The control plane verifies
  // the nonce at submission time (Phase 18W-C) — preventing replay of a
  // launcher-signed attestation from a different execution.
  substrateNonce  String?

  // Phase 18X-B: The signed ExecutionCapability issued for this job. The
  // control plane signs this with its Ed25519 private key (the SAME key used
  // for token signing — Phase 18P) at job-spec time and persists the JSON
  // here. At submit-runtime-evidence time, the control plane audits that the
  // attestation's nonce / executionId match the capability's values
  // (defense-in-depth — the supervisor already verified the capability's
  // signature before running the substrate). Binds executionId + nonce +
  // leaseId + repoSha + planHash + archHash + expiresAt.
  //
  // Phase 18Y: the capability ALSO binds workloadHash + runtimePlan (the
  // FULL plan). The supervisor DERIVES the workload from cap.runtimePlan —
  // the worker does NOT supply the workload.
  substrateCapability String?

  // Phase 18Y: Atomic nonce consumption (anti-replay). The supervisor calls
  // /api/supervisor/consume-capability BEFORE running the substrate. The
  // control plane's updateMany with:
  //   where: { executionId, substrateNonce: nonce,
  //            substrateNonceConsumed: false, leaseId,
  //            leaseExpiresAt: { gt: now } }
  //   data:  { substrateNonceConsumed: true,
  //            substrateNonceConsumedAt: now }
  // is atomic: the first call returns count=1 (consumed), any subsequent
  // call returns count=0 (replay → 403). The lease check is in the WHERE
  // clause, so a reclaimed or expired lease → 403.
  substrateNonceConsumed     Boolean  @default(false)
  substrateNonceConsumedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Phase 18: Runtime Evidence — immutable record of runtime verification.
//
// Runtime verification executes the ACTUAL merged application at the exact
// canonical GitHub SHA. It proves the product works, not just that the code
// looks correct.
//
// PRODUCTION_READY requires BOTH:
//   - staticReadinessPassed (Phase 17 repository snapshot + scanner)
//   - runtimeVerificationPassed (Phase 18 execution evidence)
//
// This model is APPEND-ONLY — never UPDATE; only CREATE. Each verification
// run produces a new RuntimeEvidence record tied to a specific immutable SHA.
// ---------------------------------------------------------------------------

model RuntimeEvidence {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Exact revision verified — the application was executed at THIS SHA.
  repositoryHeadSha   String
  headVerified        Boolean  @default(false)

  // Phase 18A: Server-authoritative SHA binding.
  // expectedRepositoryHeadSha = project.canonicalHeadSha at submission time (server-derived, not worker-supplied).
  // executedRepositoryHeadSha = result.repositoryHeadSha (what the worker claims to have executed).
  // These must match for the evidence to be valid.
  expectedRepositoryHeadSha  String?
  executedRepositoryHeadSha  String?
  integrationBranch          String?
  // Hash of the RuntimeVerificationPlan used (for reproducibility).
  runtimePlanHash            String?
  // Hash of the architecture contract (for reproducibility).
  architectureHash           String?

  // Environment fingerprint — what environment executed the application.
  environmentFingerprint String  // JSON: { nodeVersion, platform, arch, executionMode, workerVersion }

  // Pipeline stage results (each is JSON with success, durationMs, exitCode, output)
  dependencyInstallResult String  // JSON: install command results
  buildResult             String  // JSON: build command results
  startupResult           String  // JSON: { success, port, pid, startupDurationMs }
  healthChecks            String  @default("[]") // JSON array of health check results
  apiJourneys             String  @default("[]") // JSON array of API journey results
  integrationChecks       String  @default("[]") // JSON array of integration check results
  backgroundJobChecks     String  @default("[]") // JSON array of background job results
  browserJourneys         String  @default("[]") // JSON array of browser journey results
  teardownResult          String  // JSON: { success, durationMs }

  // Overall verdict
  passed          Boolean  @default(false)
  failureReason   String?

  // Truncated logs (for debugging — full logs may be stored externally)
  logs            String?

  // Execution identity (like TaskEvidence)
  executionId     String?  // ExecutionJob that ran this verification
  workerId        String?

  // Phase 18B: Idempotency — projectId + executionId + attempt uniquely identifies
  // a runtime verification submission. Retries for the same attempt are idempotent.
  attempt         Int      @default(0)
  idempotencyKey  String   @unique  // projectId+executionId+attempt

  // Timing
  startedAt       DateTime
  completedAt     DateTime?

  createdAt       DateTime @default(now())

  // Phase 18V: Substrate attestation — observed isolation facts bound into
  // the signed ExecutionEvidenceEnvelope. JSON: SandboxAttestation
  // (observed namespace inodes, seccomp profile hash, rlimits, capabilities
  // dropped, network mode, readonly rootfs). Null when the substrate could
  // not be established (gcc missing, unshare unavailable, facts file missing)
  // — the production gate fails-closed in that case.
  substrateAttestation String?
  // Whether verifySubstrateAttestation passed at submission time. False when
  // the attestation is null OR invalid. PRODUCTION_READY requires true.
  substrateVerified     Boolean @default(false)

  // Phase 18W-B: The substrate nonce the control plane issued for this
  // execution. The launcher signs canonicalFactsJson (which includes this
  // nonce), so the persisted evidence binds the attestation to this nonce.
  // At verification time, the control plane confirms the attestation's nonce
  // matches this stored value (Phase 18W-C). Prevents replay across
  // executions.
  substrateNonce        String?

  @@index([projectId])
  @@index([repositoryHeadSha])
  @@index([passed])
}
